theme = Everforest Dark Hard
font-family = JetBrains Mono
font-size = 14
font-thicken = true
window-save-state = always
copy-on-select = clipboard
split-divider-color = #485155

###########################
#   Workspace shortcuts   #
###########################

# Windows
keybind = cmd+n=unbind
keybind = alt+n=new_window

# Tabs
keybind = alt+r=prompt_tab_title

keybind = cmd+t=unbind
keybind = alt+t=new_tab

keybind = alt+]=next_tab
keybind = alt+[=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

# Splits
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right

keybind = alt+backslash=new_split:right
keybind = alt+-=new_split:down

keybind = alt+shift+up=resize_split:up,30
keybind = alt+shift+down=resize_split:down,30
keybind = alt+shift+left=resize_split:left,40
keybind = alt+shift+right=resize_split:right,40

keybind = alt+z=toggle_split_zoom
keybind = alt+==equalize_splits

# Misc
keybind = alt+enter=toggle_quick_terminal

########################
#   Neovim shortcuts   #
########################

# Tabs
keybind = cmd+t=text:\x20tt
keybind = cmd+w=unbind
keybind = cmd+w=text:\x20wc
keybind = cmd+]=text:\x20tn
keybind = cmd+[=text:\x20tp

# Splits
keybind = cmd+up=text:\x20wk
keybind = cmd+down=text:\x20wj
keybind = cmd+left=text:\x20wh
keybind = cmd+right=text:\x20wl

keybind = cmd+\=text:\x20w\\
keybind = cmd+-=text:\x20w-

keybind = cmd+z=text:\x20wz

# Misc
keybind = cmd+e=text:\x20e
keybind = cmd+shift+f=text:\x20pg
keybind = cmd+s=text:\x20bs
keybind = cmd+shift+s=text:\x20bS
keybind = cmd+p=text:\x20ff
keybind = cmd+.=text:\x20bca

keybind = cmd+enter=unbind
keybind = cmd+backspace=unbind
keybind = shift+enter=text:\n
