[user]
name = Siddhant
email = git@sdnts.dev
signingkey = ~/.ssh/id_ed25519.pub

[gpg]
format = ssh

[commit]
gpgsign = true

[tag]
gpgsign = true

[advice]
addIgnoredFile = false

[init]
defaultBranch = main

[rebase]
autosquash = true
updateRefs = true

[merge]
conflictstyle = diff3

[push]
autoSetupRemote = true

[remote "origin"]
prune = true
